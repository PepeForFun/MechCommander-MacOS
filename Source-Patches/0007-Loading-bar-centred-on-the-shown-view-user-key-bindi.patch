+    constexpr uint32_t NoKey = 0xffffffffu;
+
+    std::string Lower(std::string_view text)
+    {
+        std::string lower(text);
+        std::ranges::transform(lower, lower.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+        return lower;
+    }
+
+    std::string_view Trim(std::string_view text)
+    {
+        while (!text.empty() && std::isspace(static_cast<unsigned char>(text.front())))
+        {
+            text.remove_prefix(1);
+        }
+
+        while (!text.empty() && std::isspace(static_cast<unsigned char>(text.back())))
+        {
+            text.remove_suffix(1);
+        }
+
+        return text;
+    }
+
+    /// <summary>A binding as text ("Ctrl+J", "None").</summary>
+    std::string KeyText(uint32_t key)
+    {
+        if (key == NoKey || (key & 0xffffu) == 0xffffu)
+        {
+            return "None";
+        }
+
+        std::string text;
+
+        if ((key & KeyCtrl) != 0)
+        {
+            text += "Ctrl+";
+        }
+
+        if ((key & KeyAlt) != 0)
+        {
+            text += "Alt+";
+        }
+
+        if ((key & KeyShift) != 0)
+        {
+            text += "Shift+";
+        }
+
+        const uint32_t code = key & 0xffffu;
+
+        for (const MCScanName& scan : ScanCodeNames)
+        {
+            if (scan.Code == code)
+            {
+                return text + std::string(scan.Name);
+            }
+        }
+
+        return text + std::format("0x{:x}", code);
+    }
+
+    /// <summary>A binding from text, or nothing when it can't be read.</summary>
+    std::optional<uint32_t> ParseKey(std::string_view text)
+    {
+        text = Trim(text);
+
+        if (Lower(text) == "none")
+        {
+            return NoKey;
+        }
+
+        uint32_t modifiers = 0;
+
+        while (true)
+        {
+            const size_t plus = text.find('+');
+
+            if (plus == std::string_view::npos || plus + 1 >= text.size())
+            {
+                break;
+            }
+
+            const std::string modifier = Lower(Trim(text.substr(0, plus)));
+
+            if (modifier == "ctrl" || modifier == "control")
+            {
+                modifiers |= KeyCtrl;
+            }
+            else if (modifier == "alt" || modifier == "option")
+            {
+                modifiers |= KeyAlt;
+            }
+            else if (modifier == "shift")
+            {
+                modifiers |= KeyShift;
+            }
+            else
+            {
+                return std::nullopt;
+            }
+
+            text = Trim(text.substr(plus + 1));
+        }
+
+        const std::string name = Lower(text);
+
+        for (const MCScanName& scan : ScanCodeNames)
+        {
+            if (Lower(scan.Name) == name)
+            {
+                return scan.Code | modifiers;
+            }
+        }
+
+        if (name.starts_with("0x"))
+        {
+            uint32_t code = 0;
+            const auto [end, error] = std::from_chars(name.data() + 2, name.data() + name.size(), code, 16);
+
+            if (error == std::errc{} && end == name.data() + name.size() && code < 0x10000)
+            {
+                return code | modifiers;
+            }
+        }
+
+        return std::nullopt;
+    }
+
+    std::filesystem::path KeyConfigPath()
+    {
+        const std::filesystem::path& user = MCFileSystem::UserRoot();
+        return user.empty() ? std::filesystem::path() : user / "keys.cfg";
+    }
+
+    /// <summary>Writes keys.cfg with <paramref name="keys"/> when there is none.</summary>
+    void WriteKeyConfigIfMissing(const std::array<uint32_t, NumKeyCommands>& keys)
+    {
+        const std::filesystem::path path = KeyConfigPath();
+        std::error_code error;
+
+        if (path.empty() || std::filesystem::exists(path, error))
+        {
+            return;
+        }
+
+        std::ofstream out(path);
+
+        if (!out)
+        {
+            return;
+        }
+
+        out << "# MechCommander Redux key bindings (in-mission commands).\n"
+               "# Change the key after '=' and save; the next mission uses it.\n"
+               "# Modifiers: Ctrl+, Alt+ (Option on a Mac keyboard), Shift+   e.g.  Jump = Ctrl+J\n"
+               "# 'None' removes a binding. Delete this file to get the original keys back.\n"
+               "# Key names: A-Z, 0-9, F1-F12, Space, Enter, Tab, Esc, Backspace, Home, End, PageUp, PageDown,\n"
+               "#   Insert, Delete, Up, Down, Left, Right, Minus, Equals, Comma, Period, Slash, Semicolon, Quote,\n"
+               "#   LeftBracket, RightBracket, Backslash, Backquote, Keypad0-Keypad9, KeypadPlus, KeypadMinus,\n"
+               "#   KeypadMultiply, KeypadDivide, KeypadPeriod, KeypadEnter\n\n";
+
+        for (const MCKeyName& entry : KeyCommandNames)
+        {
+            out << std::format("{} = {}\n", entry.Name, KeyText(keys[static_cast<size_t>(entry.Command)]));
+        }
+    }
+
+    /// <summary>Applies keys.cfg to <paramref name="keys"/>; unreadable lines are logged and skipped.</summary>
+    void ApplyKeyConfig(std::array<uint32_t, NumKeyCommands>& keys)
+    {
+        WriteKeyConfigIfMissing(keys);
+        const std::filesystem::path path = KeyConfigPath();
+        std::ifstream in(path);
+
+        if (path.empty() || !in)
+        {
+            return;
+        }
+
+        std::string line;
+        int lineNumber = 0;
+
+        while (std::getline(in, line))
+        {
+            ++lineNumber;
+            const std::string_view text = Trim(line);
+
+            if (text.empty() || text.front() == '#' || text.front() == ';')
+            {
+                continue;
+            }
+
+            const size_t equals = text.find('=');
+
+            if (equals == std::string_view::npos)
+            {
+                SDL_Log("keys.cfg line %d: no '=' (skipped)", lineNumber);
+                continue;
+            }
+
+            const std::string name = Lower(Trim(text.substr(0, equals)));
+            const auto command = std::ranges::find_if(KeyCommandNames, [&](const MCKeyName& entry)
+                                                      { return Lower(entry.Name) == name; });
+
+            if (command == std::end(KeyCommandNames))
+            {
+                SDL_Log("keys.cfg line %d: unknown action '%s' (skipped)", lineNumber, name.c_str());
+                continue;
+            }
+
+            const std::optional<uint32_t> key = ParseKey(text.substr(equals + 1));
+
+            if (!key)
+            {
+                SDL_Log("keys.cfg line %d: unknown key '%s' (skipped)", lineNumber,
+                        std::string(Trim(text.substr(equals + 1))).c_str());
+                continue;
+            }
+
+            keys[static_cast<size_t>(command->Command)] = *key;
+        }
+    }
+
