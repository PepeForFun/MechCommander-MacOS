From 7257409e2d58d1c07d865eae67bb39ace30fad5a Mon Sep 17 00:00:00 2001
From: MechCommander Redux Mac port <mac-port@users.noreply.invalid>
Date: Sun, 18 Oct 2026 11:29:06 +0200
Subject: [PATCH 7/9] Loading bar centred on the shown view; user key bindings
 in keys.cfg

- DrawProgress: centre on the display's view. While a mission loads the screen
  already has the mission's size but the menus' 640x480 view is shown, which put
  the bar half off the screen.
- keys.cfg in the user folder ("Action = Key", Ctrl+/Alt+/Shift+, None) overrides
  the in-mission bindings; written with the defaults when missing; bad lines are
  logged and skipped.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/lib/MCCore/gui/MCUpdateDisplay.cpp       |  25 +-
 src/lib/MCCore/iface/MCTacticalInterface.cpp | 422 +++++++++++++++++++
 2 files changed, 445 insertions(+), 2 deletions(-)

diff --git a/src/lib/MCCore/gui/MCUpdateDisplay.cpp b/src/lib/MCCore/gui/MCUpdateDisplay.cpp
index 8159384..b2793fd 100644
--- a/src/lib/MCCore/gui/MCUpdateDisplay.cpp
+++ b/src/lib/MCCore/gui/MCUpdateDisplay.cpp
@@ -194,8 +194,29 @@ namespace
     /// <summary>The connect shape at the screen's centre, with a progress bar of <paramref name="progress"/> percent.</summary>
     void DrawProgress(int32_t progress)
     {
-        const int32_t centerY = GuiSystem().Height() >> 1;
-        const int32_t centerX = GuiSystem().Width() >> 1;
+        // Port fix: centre on the part of the screen that is shown. While a mission loads, the screen already has
+        // the mission's size (e.g. 1280x720) but the display still shows the menus' 640x480 view of it, which put the
+        // bar half off the screen.
+        int32_t width = GuiSystem().Width();
+        int32_t height = GuiSystem().Height();
+        int32_t viewX = 0;
+        int32_t viewY = 0;
+
+        if (const std::shared_ptr<MCDisplay> display = MCInput::Display(); display != nullptr)
+        {
+            const SDL_Rect view = display->View();
+
+            if (view.w > 0 && view.h > 0)
+            {
+                viewX = view.x;
+                viewY = view.y;
+                width = std::min(width - viewX, view.w);
+                height = std::min(height - viewY, view.h);
+            }
+        }
+
+        const int32_t centerY = viewY + (height >> 1);
+        const int32_t centerX = viewX + (width >> 1);
         AGShapeDraw(ScreenPort()->Frame(), ConnectShape().Bytes(), 0, centerX, centerY);
         const int32_t left = centerX - 0x5f;
         const auto right = static_cast<int32_t>(progress * 0.01 * 188.0 + left);
