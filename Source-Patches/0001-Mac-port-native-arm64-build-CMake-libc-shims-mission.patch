diff --git a/src/lib/MCCore/gui/MCUpdateDisplay.cpp b/src/lib/MCCore/gui/MCUpdateDisplay.cpp
index 7f73ee4..8159384 100644
--- a/src/lib/MCCore/gui/MCUpdateDisplay.cpp
+++ b/src/lib/MCCore/gui/MCUpdateDisplay.cpp
@@ -286,7 +286,12 @@ int32_t UpdateDisplay(bool screenShot, bool staticNoise, int32_t noiseChance, bo
 
         for (int32_t i = 0; i < ScreenWindow()->NumberOfChildren(); i++)
         {
-            ScreenWindow()->Child(i)->Display();
+            // Mac port: ChildList holds weak_ptrs, and a child can expire during scenario load before it is
+            // removed; skip it like MCGuiSystem::Run does.
+            if (const std::shared_ptr<MCGuiObject> child = ScreenWindow()->Child(i); child != nullptr)
+            {
+                child->Display();
+            }
         }
     }
     else
diff --git a/src/lib/MCCore/platform/MCServices.cpp b/src/lib/MCCore/platform/MCServices.cpp
index c4f8c83..827ae79 100644
--- a/src/lib/MCCore/platform/MCServices.cpp
+++ b/src/lib/MCCore/platform/MCServices.cpp
@@ -43,8 +43,17 @@ uint64_t MCSystemClock::UtcFileTime()
 
 uint64_t MCSystemClock::LocalFileTime()
 {
+#if defined(__APPLE__)
+    // libc++ has no std::chrono::current_zone(); use the C library's UTC offset for "now".
+    const auto now = std::chrono::system_clock::now();
+    const std::time_t t = std::chrono::system_clock::to_time_t(now);
+    std::tm local{};
+    localtime_r(&t, &local);
+    return ToFileTime(now.time_since_epoch() + std::chrono::seconds(local.tm_gmtoff));
+#else
     const auto local = std::chrono::current_zone()->to_local(std::chrono::system_clock::now());
     return ToFileTime(local.time_since_epoch());
+#endif
 }
 
 int32_t MCCrtRandom::Next()
