index 0000000..c516353
--- /dev/null
+++ b/src/mac/CMakeLists.txt
@@ -0,0 +1,44 @@
+# macOS build of MechCommander Redux (personal port; the Windows build stays on MSBuild).
+# Builds bundled SDL3 + mimalloc, MCCore as a static library and MCRedux as the game executable.
+# The Vulkan presenter is compiled but has no SPIR-V on macOS, so MCDisplay falls back to the
+# software renderer + SDL_Renderer (Metal) presenter.
+cmake_minimum_required(VERSION 3.24)
+project(MCReduxMac LANGUAGES C CXX OBJC)
+
+set(MC_SRC ${CMAKE_CURRENT_SOURCE_DIR}/..)
+set(CMAKE_CXX_STANDARD 23)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_OSX_ARCHITECTURES arm64)
+if(NOT CMAKE_BUILD_TYPE)
+  set(CMAKE_BUILD_TYPE Release)
+endif()
+
+set(SDL_SHARED OFF CACHE BOOL "" FORCE)
+set(SDL_STATIC ON CACHE BOOL "" FORCE)
+set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
+add_subdirectory(${MC_SRC}/lib/SDL-release-3.4.12 sdl EXCLUDE_FROM_ALL)
+
+set(MI_BUILD_SHARED OFF CACHE BOOL "" FORCE)
+set(MI_BUILD_OBJECT OFF CACHE BOOL "" FORCE)
+set(MI_BUILD_TESTS OFF CACHE BOOL "" FORCE)
+set(MI_OVERRIDE OFF CACHE BOOL "" FORCE)  # new/delete come from mimalloc-new-delete.h in MCAllocator.cpp
+add_subdirectory(${MC_SRC}/lib/mimalloc-3.3.1 mimalloc EXCLUDE_FROM_ALL)
+
+include(${CMAKE_CURRENT_SOURCE_DIR}/sources.cmake)
+list(LENGTH MCCORE_SOURCES _n)
+message(STATUS "MCCore sources: ${_n} MC_SRC=${MC_SRC}")
+
+add_library(MCCore STATIC ${MCCORE_SOURCES})
+target_include_directories(MCCore PUBLIC
+  ${MC_SRC}/lib/MCCore
+  ${MC_SRC}/lib/mimalloc-3.3.1/include
+  ${CMAKE_CURRENT_SOURCE_DIR}/generated)
+target_precompile_headers(MCCore PRIVATE ${MC_SRC}/lib/MCCore/stdafx.h)
+target_link_libraries(MCCore PUBLIC SDL3::SDL3-static mimalloc-static)
+target_compile_options(MCCore PRIVATE -Wno-everything $<$<COMPILE_LANGUAGE:CXX>:-include ${CMAKE_CURRENT_SOURCE_DIR}/prelude.h>)
+
+add_executable(MCRedux ${MCREDUX_SOURCES})
+target_include_directories(MCRedux PRIVATE ${MC_SRC}/apps/MCRedux)
+target_precompile_headers(MCRedux PRIVATE ${MC_SRC}/apps/MCRedux/stdafx.h)
+target_link_libraries(MCRedux PRIVATE MCCore)
+target_compile_options(MCRedux PRIVATE -Wno-everything $<$<COMPILE_LANGUAGE:CXX>:-include ${CMAKE_CURRENT_SOURCE_DIR}/prelude.h>)
