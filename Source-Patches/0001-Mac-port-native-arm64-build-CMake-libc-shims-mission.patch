diff --git a/src/mac/prelude.h b/src/mac/prelude.h
new file mode 100644
index 0000000..4bc13ec
--- /dev/null
+++ b/src/mac/prelude.h
@@ -0,0 +1,48 @@
+// Mac build: standard headers MSVC's STL pulls in transitively. Force-included before every TU.
+#pragma once
+#ifdef __cplusplus
+#include <list>
+#include <queue>
+#include <stack>
+#include <unordered_set>
+#include <variant>
+#include <sstream>
+#include <random>
+#include <bitset>
+#include <tuple>
+#include <iomanip>
+#include <cwchar>
+#include <cwctype>
+#include <limits>
+#include <type_traits>
+#include <iterator>
+#include <system_error>
+#endif
+
+#ifdef __cplusplus
+// libc++ (Apple clang 21) lacks std::atomic<std::shared_ptr<T>> / <std::weak_ptr<T>> (C++20, P0718).
+// Mutex-backed stand-ins with the operations Redux uses (load/store/exchange, default construction).
+#include <atomic>
+#include <memory>
+#include <mutex>
+#if !defined(__cpp_lib_atomic_shared_ptr)
+namespace std {
+template <class P> struct __mc_atomic_smart {
+    __mc_atomic_smart() noexcept = default;
+    __mc_atomic_smart(P p) noexcept : _p(std::move(p)) {}
+    __mc_atomic_smart(const __mc_atomic_smart&) = delete;
+    __mc_atomic_smart& operator=(const __mc_atomic_smart&) = delete;
+    P load(memory_order = memory_order_seq_cst) const { lock_guard<mutex> g(_m); return _p; }
+    void store(P p, memory_order = memory_order_seq_cst) { lock_guard<mutex> g(_m); _p.swap(p); }
+    P exchange(P p, memory_order = memory_order_seq_cst) { lock_guard<mutex> g(_m); _p.swap(p); return p; }
+    operator P() const { return load(); }
+    void operator=(P p) { store(std::move(p)); }
+private:
+    mutable mutex _m;
+    P _p;
+};
+template <class T> struct atomic<shared_ptr<T>> : __mc_atomic_smart<shared_ptr<T>> { using __mc_atomic_smart<shared_ptr<T>>::__mc_atomic_smart; using __mc_atomic_smart<shared_ptr<T>>::operator=; };
+template <class T> struct atomic<weak_ptr<T>> : __mc_atomic_smart<weak_ptr<T>> { using __mc_atomic_smart<weak_ptr<T>>::__mc_atomic_smart; using __mc_atomic_smart<weak_ptr<T>>::operator=; };
+}
+#endif
+#endif
